{
  "version": 2,
  "builds": [
    {
      "src": "index (2).html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/api/(.*)",
      "dest": "https://jntua-labs-backend.onrender.com/api/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index (2).html"
    }
  ]
}
