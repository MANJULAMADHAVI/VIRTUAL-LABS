{
  "version": 2,
  "builds": [
    {
      "src": "index (2).html",
      "use": "@vercel/static"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://jntua-labs-backend.onrender.com/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index (2).html"
    }
  ]
}
