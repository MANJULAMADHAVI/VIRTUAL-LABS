{
  "version": 2,
  "builds": [
    {
      "src": "index (2).html",
      "use": "@vercel/static"
    },
    {
      "src": "logo1.webp",
      "use": "@vercel/static"
    },
    {
      "src": "logo.svg",
      "use": "@vercel/static"
    },
    {
      "src": "assets/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/(.*\\.(?:png|jpg|jpeg|gif|svg|webp|ico|css|js|json|woff|woff2|ttf|map))",
      "dest": "/$1"
    },
    {
      "src": "/api/(.*)",
      "dest": "https://jntua-labs-backend.onrender.com/api/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index (2).html"
    }
  ]
}
