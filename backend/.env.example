# ============================================
# JNTUA LABS - Production Environment Template
# ============================================
# Copy this file to .env and fill in your values

# Server Configuration
PORT=5000
NODE_ENV=production

# Database Configuration (Local or Cloud)
# Local MySQL:
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=root
DB_NAME=jntua_labs
DB_PORT=3306
DB_SSL=false

# OR use a cloud MySQL connection URL:
# DB_URL=mysql://username:password@host:3306/database_name
# MYSQL_URL=mysql://username:password@host:3306/database_name

# Security
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# Judge0 API (for code execution)
JUDGE0_API_KEY=your_rapidapi_judge0_key
JUDGE0_ENDPOINT=https://judge0-ce.p.rapidapi.com

# OpenAI API (for AI chatbot)
OPENAI_API_KEY=sk-your-openai-api-key

# Frontend CORS
CORS_ORIGIN=http://localhost:8000
# Production CORS:
# CORS_ORIGIN=https://jntua-labs.vercel.app

# Logging
LOG_LEVEL=info

# Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password
SMTP_FROM=noreply@jntua-labs.edu

# Admin Dashboard
ADMIN_SECRET=admin_panel_secret_key
